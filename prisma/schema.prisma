generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  customerType   String?
  openingBalance Float    @default(0)
  createdAt      DateTime @default(now())

  documents FinancialDocument[]
  payments  Payment[]
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  openingBalance Float    @default(0)
  createdAt      DateTime @default(now())

  ledgerEntries LedgerEntry[]
  products      Product[]
}

model Employee {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  openingBalance Float    @default(0)
  /// תפקיד / תיאור לתצוגה (למשל: מטבח, אריזה)
  role           String?
  /// מחלקה לצבעי UI
  department     String?
  createdAt      DateTime @default(now())

  linkedUsers   User[]
  ledgerEntries LedgerEntry[]
}

/// Manual ledger lines for ספק / עובד (לא כרטסת לקוח — היא מחושבת ממסמכים ותשלומים)
model LedgerEntry {
  id          String   @id @default(cuid())
  entryDate   DateTime @db.Date
  docType     String
  description String
  debit       Float    @default(0)
  credit      Float    @default(0)
  createdAt   DateTime @default(now())

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([employeeId])
}

model FinancialDocument {
  id              String   @id @default(cuid())
  title           String
  category        String
  documentType    String
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  totalAmount     Float
  paidAmount      Float    @default(0)
  remainingAmount Float
  /// paid | partial | unpaid
  paymentStatus   String   @default("unpaid")
  /// פיקדון לקוחות אירועים — נשמר בנפרד מהמוצרים/מכירות
  depositAmount   Float    @default(0)
  depositType     String?
  depositNote     String?
  /// open | returned | refunded
  depositStatus   String   @default("open")

  notes    String?
  metadata Json?

  pdfStoragePath String?
  sentToCpa      Boolean  @default(false)
  docDate        DateTime? @db.Date
  createdAt      DateTime @default(now())

  items    FinancialDocumentItem[]
  payments Payment[]
  /// תנועות תזרים שמקושרות כדוח Z (אותו מסמך כ־FinancialDocument)
  zReportCashFlowEntries CashFlowEntry[] @relation("CashFlowZReportFinancialDocument")

  @@index([customerId])
  @@index([createdAt])
}

model FinancialDocumentItem {
  id         String @id @default(cuid())
  documentId String
  document   FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?
  itemName    String
  quantity    Float
  unitPrice   Float
  vatType     String?
  total       Float

  @@index([documentId])
  @@index([productId])
}

model Payment {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  documentId String?
  document   FinancialDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  amount        Float
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@index([documentId])
}

model CashFlowEntry {
  id                String   @id @default(cuid())
  entryType         String
  amount            Float
  description       String?
  paymentMethod     String?
  customerId        String?
  customerName      String?
  notes             String?
  paymentId         String?
  documentId        String?
  relatedDocumentId String?
  /// מקור התנועה: לדוגמה z_report
  source            String?
  /// מזהה דוח Z בפועל — שורת FinancialDocument עם documentType "דוח Z"
  zReportId         String?
  zReport           FinancialDocument? @relation("CashFlowZReportFinancialDocument", fields: [zReportId], references: [id], onDelete: Cascade)
  entryDate         DateTime @db.Date
  isDirect          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([entryDate])
  @@index([customerId])
  @@index([paymentId])
  @@index([documentId])
  @@index([relatedDocumentId])
  @@index([zReportId])
  @@index([source])
}

model GeneratedPdf {
  id         String   @id @default(cuid())
  customerId String?
  documentId String?
  pdfUrl     String
  kind       String?
  createdAt  DateTime @default(now())
}

/// דוחות PDF שנשמרו ב־Storage — מקור האמת לארכיון (עצמאי ממחיקת מסמך מקור)
model GeneratedReport {
  id          String   @id @default(cuid())
  /// INCOME | EXPENSE | Z_REPORT | CASHFLOW | PAYMENT
  type        String
  title       String
  relatedId   String?
  fileName    String
  filePath    String
  publicUrl   String
  createdById String?
  createdBy   User?    @relation("GeneratedReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([relatedId])
  @@index([createdAt])
  @@index([createdById])
}

model ProductHistory {
  id        String   @id @default(cuid())
  itemName  String   @unique
  createdAt DateTime @default(now())
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  products  Product[]
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  currentStock  Int       @default(0)
  minStock      Int       @default(0)
  lastStockAt   DateTime?
  lastStockById String?
  lastStockBy   User?     @relation("ProductLastStockBy", fields: [lastStockById], references: [id], onDelete: SetNull)

  documentItems      FinancialDocumentItem[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([supplierId])
}

/// חומרי גלם ומלאי פנימי לספירה — לא מוצרי מכירה
model InventoryProduct {
  id               String   @id @default(cuid())
  name             String
  location         String
  /// חומרי גלם | אריזות | קירור | מדבקות | כללי
  category         String   @default("כללי")
  minimumQuantity  Float    @default(0)
  unit             String?
  createdAt        DateTime @default(now())

  counts InventoryCount[]

  @@unique([name])
}

/// כל ספירה נשמרת; משווה לספירה הקודמת של אותו פריט
model InventoryCount {
  id                 String           @id @default(cuid())
  inventoryProductId String
  inventoryProduct   InventoryProduct @relation(fields: [inventoryProductId], references: [id], onDelete: Cascade)
  countDate          DateTime
  previousQuantity   Float
  currentQuantity    Float
  difference         Float
  note               String?
  createdAt          DateTime         @default(now())
  countedByUserId    String?
  countedBy          User?            @relation("InventoryCountCountedBy", fields: [countedByUserId], references: [id], onDelete: SetNull)

  @@index([inventoryProductId])
  @@index([countDate])
  @@index([difference])
  @@index([countedByUserId])
}

/// תנועות מלאי יומיות — מעדכנות currentStock במוצר
model InventoryMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// STOCK_IN | SHORTAGE | DAMAGE | RETURN | STOCK_FIX | TRANSFER
  type        String
  quantity    Int
  notes       String?
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@index([createdById])
}

model EmployeeTask {
  id          String   @id @default(cuid())
  /// משתמש עם role EMPLOYEE — אין שימוש בטבלת Employee למשימות
  assigneeId  String
  assignee    User     @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  /// קיבוץ משימות שהוקצו יחד למספר עובדים (אותה הקצאה)
  groupId     String?
  title       String
  description String?
  /// normal | low | medium | high | urgent
  priority    String   @default("normal")
  /// pending | in_progress | completed (באיחור מחושב לפי שעת התחלה המתוזמנת)
  status      String   @default("pending")
  /// תאריך המשימה (יום בלוח)
  taskDate    DateTime
  /// שעת התחלה מתוזמנת לעובד (פורמט HH:mm)
  startTime   String
  /// שעת סיום מתוזמנת לעובד (פורמט HH:mm) — לא זמן עבודה בפועל
  endTime     String?
  startedAt   DateTime?
  completedAt DateTime?
  /// יעד (יום) — לא חובה; איחור מחושב גם מ־taskDate+startTime אם לא הוגדר
  dueDate     DateTime? @db.Date
  /// הערת עובד (חסר חומר, טופל, וכו׳)
  employeeNote String?
  /// משתמש שיצר את המשימה (מנהל)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assigneeId])
  @@index([taskDate])
  @@index([groupId])
  @@index([status])
  @@index([createdAt])
  @@index([startedAt])
}

/// שדות לטפסים דינמיים — לא רק תווית
model DynamicFormField {
  id           String   @id @default(cuid())
  label        String
  /// STRING | NUMBER | EMAIL | PHONE | DATE | TIME | TEXTAREA | SELECT | BOOLEAN
  fieldType    String   @default("STRING")
  placeholder  String?
  required     Boolean  @default(false)
  /// ל‑SELECT: מערך מחרוזות אפשרויות
  optionsJson  Json?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("FormFieldDef")
}

model FinanceSettings {
  id                 Int    @id @default(1)
  cashOpeningBalance Float  @default(0)
}

enum UserRole {
  SUPER_ADMIN
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  /// אופציונלי — קישור לרשומת Employee בכרטסות (לא למשימות)
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  permissions   UserPermission[]
  activityLogs  ActivityLog[]
  assignedTasks EmployeeTask[]

  productLastStockUpdates Product[]           @relation("ProductLastStockBy")
  inventoryMovements      InventoryMovement[]
  inventoryCountsRecorded InventoryCount[]    @relation("InventoryCountCountedBy")
  generatedReports        GeneratedReport[]   @relation("GeneratedReportCreatedBy")

  @@index([employeeId])
}

model UserPermission {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String

  @@unique([userId, permission])
  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
